[e] screenEditorPage
    [e] parameters
        [e] modelName
            [v] NOT_DEFINED
        [e] package
            [v] NOT_DEFINED
    [e] vars
        [e] screenClass
            [e] select
                [v] /classes/class[@name = $modelName and @package = $package]
        [e] objectType
            [e] expr
                [v] $screenClass/attributes/attribute[@name = 'object']/@type
        [e] beanLower
            [e] expr
                [v] mi:first-lower($objectType)
        [e] hasDescription
            [e] expr
                [v] exists($screenClass/properties/description/pt/value)
    [e] patterns
        [e] page-head
            [v] // GERADO por: mi generate <projeto> frontend screenEditorPage modelName={{ @name }} package={{ @package }}
            [v] // Fonte: mapa de tela {{ @name }} + dominio {{ $objectType }}. NAO editar a mao — rode o gerador.
            [v] import { toast } from "sonner"
            [v] import { useCriar{{ $objectType }} } from "@/gen/api/{{ $beanLower }}"
            [v] import { {{ @name }}Form, type {{ @name }}Values } from "./{{ @name }}"
            [v]
            [v] export function {{ @name }}Screen() {
            [v]   const criar = useCriar{{ $objectType }}()
            [v]   async function handleSubmit(values: {{ @name }}Values) {
            [v]     await criar.mutateAsync(values)
            [v]     toast.success("Dados salvos com sucesso.")
            [v]   }
            [v]   return (
            [v]     <main className="mx-auto max-w-2xl p-6">
            [v]       <div className="mb-6">
            [v]         <h1 className="text-2xl font-semibold tracking-tight">{{ properties/title/pt/value }}</h1>
        [e] page-desc
            [v]         <p className="mt-1 text-sm text-muted-foreground">{{ properties/description/pt/value }}</p>
        [e] page-tail
            [v]       </div>
            [v]       <{{ @name }}Form onSubmit={handleSubmit} isSubmitting={criar.isPending} />
            [v]     </main>
            [v]   )
            [v] }
    [e] start
        [e] match
            [v] /classes/class[@name = $modelName and @package = $package]
        [e] body
            [e] write-pattern
                [v] page-head
            [e] if
                [v] $hasDescription
                [e] then
                    [e] write-pattern
                        [v] page-desc
            [e] write-pattern
                [v] page-tail
