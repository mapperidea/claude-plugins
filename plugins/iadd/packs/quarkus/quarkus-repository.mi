        [e] escopo-import
            [v] import com.exemplo.tenant.EscopoTenant;
        [e] escopo-inject
            [v] 
            [v]     /**
            [v]      * Escopo de tenant do acesso (isolamento multi-tenant). Governante desta entidade:
            [v]      * <b>{{ attributes/attribute[properties/tenantKey]/@name }}</b>, declarado com
            [v]      * {@code tenantKey} no mapa .mi.
            [v]      *
            [v]      * <p>O predicado sai daqui e nao de parametro: filtro de query e conveniencia do
            [v]      * usuario, escopo e do sistema, e os dois convivem com o do sistema mandando.
            [v]      */
            [v]     @Inject EscopoTenant escopo;
        [e] escopo-predicado-campo
            [v]         if (!escopo.irrestrito()) {
            [v]             predicates.add(cb.equal(root.get("{{ @name }}"), escopo.exigir("{{ properties/cn/value }}")));
            [v]         }
            [v] 
        [e] escopo-predicado-relacao
            [v]         if (!escopo.irrestrito()) {
            [v]             predicates.add(cb.equal(root.join("{{ @name }}", JoinType.INNER).get("id"), escopo.exigir("{{ properties/cn/value }}")));
            [v]         }
            [v] 
        [e] escopo-por-id-campo
            [v] 
            [v]     /**
            [v]      * Busca por id <b>dentro do escopo</b>. Registro de outro tenant nao e
            [v]      * encontrado — e {@code Optional.empty()} vira 404 no resource, nunca 403: 403
            [v]      * confirmaria que o id existe, que e metade do que um enumerador quer saber.
            [v]      *
            [v]      * <p>Sobrescreve o metodo do Panache de proposito: e por ele que passam tambem o
            [v]      * PUT, o PATCH e os mappers de relacionamento.
            [v]      */
            [v]     @Override
            [v]     public Optional<{{ ../../@name }}Entity> findByIdOptional(String id) {
            [v]         if (escopo.irrestrito()) {
            [v]             return find("id = ?1", id).firstResultOptional();
            [v]         }
            [v]         return find("id = ?1 and {{ @name }} = ?2", id, escopo.exigir("{{ properties/cn/value }}"))
            [v]                 .firstResultOptional();
            [v]     }
            [v] 
            [v]     /** Gemeo escopado de {@code findByIdOptional} — o Panache expoe os dois, e servico usa este. */
            [v]     @Override
            [v]     public {{ ../../@name }}Entity findById(String id) {
            [v]         return findByIdOptional(id).orElse(null);
            [v]     }
            [v] 
            [v]     /** Remocao escopada: id de outro tenant nao e encontrado, logo nao e removido. */
            [v]     @Override
            [v]     public boolean deleteById(String id) {
            [v]         return findByIdOptional(id).map(e -> { delete(e); return true; }).orElse(false);
            [v]     }
            [v] 
            [v]     /**
            [v]      * Grava <b>impondo</b> o tenant do contexto — nao valida o que veio no body.
            [v]      *
            [v]      * <p>Validar deixaria a decisao de "o que fazer quando diverge" espalhada pelos
            [v]      * resources; impor tira a escolha do chamador, que e o ponto.
            [v]      */
            [v]     @Override
            [v]     public void persist({{ ../../@name }}Entity entity) {
            [v]         if (!escopo.irrestrito()) {
            [v]             entity.set{{ mi:first-upper(@name) }}(escopo.exigir("{{ properties/cn/value }}"));
            [v]         }
            [v]         em.persist(entity);
            [v]     }
        [e] escopo-por-id-relacao
            [v] 
            [v]     /**
            [v]      * Busca por id <b>dentro do escopo</b>, pela relacao {@code {{ @name }}}.
            [v]      * Registro de outro tenant nao e encontrado — 404, nunca 403.
            [v]      */
            [v]     @Override
            [v]     public Optional<{{ ../../@name }}Entity> findByIdOptional(String id) {
            [v]         if (escopo.irrestrito()) {
            [v]             return find("id = ?1", id).firstResultOptional();
            [v]         }
            [v]         return find("id = ?1 and {{ @name }}.id = ?2", id, escopo.exigir("{{ properties/cn/value }}"))
            [v]                 .firstResultOptional();
            [v]     }
            [v] 
            [v]     /** Gemeo escopado de {@code findByIdOptional} — o Panache expoe os dois, e servico usa este. */
            [v]     @Override
            [v]     public {{ ../../@name }}Entity findById(String id) {
