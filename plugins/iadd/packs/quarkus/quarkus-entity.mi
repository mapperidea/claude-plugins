                [v]     }
        [g] @TODO
            [e] declaraTODO
                [v] //@TODO _ tem que implementar: {{ $nomeTODO }}
                [v] //Caminho xpath: {{ functx:path-to-node-with-pos(current()) }}
            [e] declara-labelEstruturaXpath
            [e] start-labelEstruturaXpath
                [y] //Estrutura xpath: .[
            [e] end-labelEstruturaXpath
                [v] ]
            [e] declara-nomeDoElemento
                [y] name()='{{ name() }}'
            [g] Estrutura xpath
                [e] declara-barra
                    [y] /
                [e] declara-contadorElementosFilhos
                    [y] count(*)={{ count(child::*) }}
                [e] declara-andEspacoEmBranco
                    [y]  and 
                [e] declara-clausulaPositionName
                    [y] child::*[position()={{ position() }} and name()='{{ name() }}']
                [e] start-clausulaContZeroText
                    [y] /.[count(*)=0 and 
                [e] end-clausulaContZeroText
                    [y] ]
                [e] declara-clausulaText
                    [y] text()='{{ text() }}'
                [e] declara-clausulaTextName
                    [y] text()
                [e] declara-prefixoName
                    [y] {{ $prefixoNome }}
                [e] declara-clausulaNotTextName
                    [y] not(text())
    [e] start
        [e] match
            [v] /classes/class[@name = $modelName and @package = $package]
        [e] body
            [g] imports
                [e] write-pattern
                    [v] package
                [e] write-pattern
                    [v] importClass
                [e] if
                    [v] attributes/attribute[@mode = 'composite']
                    [e] then
                        [e] write-pattern
                            [v] import-cascadeType
                [e] if
                    [v] attributes/attribute[@mode = 'oneToOne' or @mode = 'manyToOne' or @mode = 'oneToMany' or @mode = 'composite']
                    [e] then
                        [e] write-pattern
                            [v] import-fetchType
                [e] if
                    [v] attributes/attribute[@mode = 'oneToMany']
                    [e] then
                        [e] write-pattern
                            [v] import-list
                [e] if
                    [v] attributes/attribute[@mode = 'oneToOne' or @mode = 'manyToOne' or @mode = 'composite']
                    [e] then
                        [e] write-pattern
                            [v] import-joinColumn
                [e] if
                    [v] attributes/attribute[@mode = 'composite']
                    [e] then
                        [e] write-pattern
                            [v] import-oneToOne
                [e] if
                    [v] attributes/attribute[@mode = 'manyToOne' or @mode = 'oneToOne']
                    [e] then
                        [e] write-pattern
                            [v] import-manyToOne
                [e] if
                    [v] attributes/attribute[@mode = 'directMap']
                    [e] then
                        [e] write-pattern
                            [v] import-map
                [e] if
                    [v] attributes/attribute[@type = $mapNativeTypes/Date/value]
                    [e] then
                        [e] write-pattern
                            [v] import-date
                [e] if
                    [v] attributes/attribute[@type = $mapNativeTypes/DateTime/value]
                    [e] then
                        [e] write-pattern
                            [v] import-dateTime
                [e] apply-templates
                    [e] select
                        [v] distinct-values(attributes/attribute[@mode != 'directToField']/@type)
                    [e] parameters
                        [e] inPackage
                            [e] expr
                                [v] @package
                    [e] mode
                        [v] imports
            [g] class
                [g] init
                    [e] write-pattern
                        [v] class-start
                [g] body
                    [g] attributes
                        [e] apply-templates
                            [e] select
                                [v] attributes/attribute
                            [e] mode
                                [v] attributes
                    [g] constructors
                        [e] apply-templates
                            [e] select
                                [v] attributes
                            [e] mode
                                [v] constructors
                    [g] functions
                        [e] apply-templates
                            [e] select
                                [v] attributes
                            [e] mode
                                [v] builder
                        [e] write-pattern
                            [v] accessorSystemFields
                        [e] apply-templates
                            [e] select
                                [v] attributes/attribute
                            [e] mode
                                [v] accessors
                [g] end
                    [e] write-pattern
                        [v] class-close
    [e] templates
        [e] mode
            [v] imports
            [e] template
                [e] match
                    [v] .
                [e] parameters
                    [e] inPackage
                        [v] NOT_DEFINED
                [e] body
                    [e] vars
                        [e] var
                            [v] pacote
                            [e] expr
                                [v] substring-before(.,'.')
                        [e] var
                            [v] tipo
                            [e] expr
                                [v] substring-after(.,'.')
                        [e] var
                            [v] class
                            [e] expr
                                [v] $classes/class[@name = $tipo and ends-with(@package,$pacote)]
                    [e] if
                        [v] $class/@package != $inPackage
                        [e] then
                            [e] write-pattern
                                [v] import
        [e] mode
            [v] attributes
            [e] template
                [e] match
                    [v] attribute[@type != $mapNativeTypes/*/value]
                [e] body
                    [e] vars
                        [e] var
                            [v] pacote
                            [e] expr
                                [v] substring-before(@type,'.')
                        [e] var
                            [v] tipo
                            [e] expr
                                [v] mi:if-else(contains(@type,'.'), substring-after(@type,'.'), @type)
                        [e] var
                            [v] class
                            [e] expr
                                [v] /classes/class[@name = $tipo and ends-with(@package,$pacote)]
                    [e] if
                        [v] contains(@mode,'oneToMany')
                        [e] then
                            [e] write-pattern
                                [v] attributeCollection
                        [e] else-if
                            [v] @mode = 'directMap'
                            [e] then
                                [e] write-pattern
                                    [v] attribute-directMap
                        [e] else-if
                            [v] @mode = 'oneToOne'
                            [e] then
                                [g] annotation
                                    [e] write-pattern
                                        [v] annotation-oneToOne-inicio
                                    [g] fetch
                                        [e] if
                                            [v] properties/fetch/value = "EAGER"
                                            [e] then
                                                [e] write-pattern
                                                    [v] annotation-fetch-eager
                                            [e] else
                                                [e] write-pattern
                                                    [v] annotation-fetch-padrao
                                    [e] write-pattern
