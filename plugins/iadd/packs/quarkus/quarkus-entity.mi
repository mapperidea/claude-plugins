[e] entity
    [e] parameters
        [e] modelName
            [v] NOT_DEFINED
        [e] package
            [v] NOT_DEFINED
    [e] vars
        [e] mapNativeTypes
            [e] select
                [v] //maps/mapNativeTypes
        [e] classes
            [e] select
                [v] /classes
        [e] currentClassType
            [e] expr
                [v] $modelName
        [e] optimisticLock
            [e] expr
                [v] if (/classes/package[@name = $package]/properties/optimisticLock/value = 'false') then 'NO' else 'YES'
    [e] fragments
        [e] tabulaDescription
            [v] for $linha in functx:lines(string-join(properties/description/pt/value,codepoints-to-string(10))) return mi:tabulate-text(concat(normalize-space($linha),codepoints-to-string(10)),'* ',80)
        [e] paramSeparator
            [v] mi:if-else(position() = last(), '', ',')
        [e] column
            [v] upper-case(properties/cn/value)
    [e] patterns
        [e] package
            [v] package {{ substring-before(@package,'.domain.') }}.{{ substring-after(@package,'.domain.') }}.entity;
            [v] 
            [v] import jakarta.persistence.Column;
            [v] import jakarta.persistence.Entity;
            [v] import jakarta.persistence.GeneratedValue;
            [v] import jakarta.persistence.GenerationType;
            [v] import jakarta.persistence.Id;
            [v] import jakarta.persistence.Table;
            [v] {{ if ($optimisticLock = 'YES') then 'import jakarta.persistence.Version;' else 'import jakarta.persistence.Transient;'
            [v] import java.time.LocalDateTime;
        [e] class-start
            [v] 
            [v] /*
            [v] {{ f#[tabulaDescription] }}
            [v] */
            [v] @Entity
            [v] @Table(name = "{{ upper-case(@name) }}")
            [v] public class {{ @name }}Entity {
            [v]
            [v]     {{ if ($optimisticLock = 'YES') then '@Version' else '//For future use of optimistic lock' }}
            [v]     {{ if ($optimisticLock = 'YES') then '@Column(name="VERSION")' else '@Transient' }}
            [v]     private LocalDateTime version;
        [e] class-close
            [v] 
            [v] }
        [g] attributes
            [g] oneToOne
                [e] attribute-oneToOne
                    [v]     private {{ $class/@name }}Entity {{ @name }};
                [g] annotation
                    [e] annotation-oneToOne-inicio
                        [v] 
                        [y]     @ManyToOne(
                    [e] annotation-oneToOne-fim
                        [v] )
                        [v]     @JoinColumn(name="{{ f#[column] }}", nullable = true)
                    [e] annotation-fetch-eager
                        [y] fetch = FetchType.EAGER
                    [e] annotation-fetch-padrao
                        [y] fetch = FetchType.LAZY
            [g] manyToOne
                [e] attribute-manyToOne
                    [v]     private {{ $class/@name }}Entity {{ @name }};
                [g] annotation
                    [e] annotation-manyToOne-inicio
                        [v] 
                        [y]     @ManyToOne(
                    [e] annotation-manyToOne-fim
                        [v] )
                        [v]     @JoinColumn(name="{{ f#[column] }}", nullable = true)
            [e] attributeComposite
                [v] 
                [v]     @OneToOne(fetch = FetchType.LAZY, cascade = CascadeType.ALL)
                [v]     @JoinColumn(name="{{ f#[column] }}", nullable = true)
                [v]     private {{ $class/@name }}Entity {{ @name }};
            [e] attributeDate
                [v] 
                [v]     @Column(name="{{ f#[column] }}")
                [v]     private LocalDate {{ @name }};
            [e] attributeDateTime
                [v] 
                [v]     @Column(name="{{ f#[column] }}")
                [v]     private LocalDateTime {{ @name }};
            [e] attributeCollection
                [v] 
                [v]     @OneToMany(mappedBy="{{ $class/attributes/attribute[@mode = 'manyToOne' and @type = $currentClassType]/@name }}", fetch = FetchType.LAZY)
                [v]     private List<{{ $class/@name }}Entity> {{ @name }};
            [e] attribute-directMap
                [v] 
                [v]     private Map<{{ $class/@name }}Entity> {{ @name }};
            [e] attributeString
                [v]     private String {{ @name }};
            [e] attributeIdUuid
                [v]
                [v]     @Id
                [v]     @GeneratedValue(strategy = GenerationType.UUID)
                [v]     @Column(name = "{{ f#[column] }}", updatable = false, nullable = false, length = {{ @typeParameter }})
                [v]     private String {{ @name }};
            [e] attributeBinary
                [v] 
                [v]     // SEM @Lob, e isso e deliberado: em PostgreSQL, @Lob byte[] mapeia para OID
                [v]     // (large object), nao para BYTEA. Large object tem ciclo de vida PROPRIO --
                [v]     // apagar a linha NAO apaga o objeto, quem apaga e lo_unlink --, entao toda
                [v]     // entidade que zere um campo binario vazaria: objeto orfao em pg_largeobject,
                [v]     // sem dono, sem referencia e sem ninguem para notar.
                [v]     // Comportamento confirmado por teste de integracao em Postgres real.
                [v]     // Em H2 o defeito e INVISIVEL (o schema de teste sai da propria anotacao).
                [v]     // Quem precisar de large object de verdade tem caso diferente e merece
                [v]     // declaracao explicita, nao default.
                [v]     // O `length` NAO e decorativo: sem ele, o H2 cria BINARY VARYING(255) e um
                [v]     // upload de 300 bytes ja estoura. Postgres ignora tamanho em BYTEA, entao a
                [v]     // anotacao so tem efeito onde o schema sai da anotacao -- que e o perfil de
                [v]     // teste. Sem isto, o defeito e invisivel em producao e constante no teste.
                [v]     @Column(name="{{ f#[column] }}"{{ if (@typeParameter != '') then concat(', length=', @typeParameter) else '' }})
                [v]     private byte[] {{ @name }};
            [e] attributeInteger
                [v]     private Integer {{ @name }};
            [e] attributeLong
                [v] 
                [v]     @Column(name="{{ f#[column] }}")
                [v]     private Long {{ @name }};
            [e] attributeDouble
                [v]     private Double {{ @name }};
            [e] attributeBoolean
                [v] 
                [v]     @Column(name="{{ f#[column] }}")
                [v]     private Boolean {{ @name }};
            [e] quebraLinha
                [v] 
            [g] annotation
                [g] Column
                    [e] annotationColumn-inicio
                        [y]     @Column(name="{{ f#[column] }}"
                    [e] annotationColumn-fim
                        [v] )
                    [e] annotationColumn-length
                        [y] , length={{ @typeParameter }}
                    [e] annotationColumn-columnDefinition
                        [y] , columnDefinition="TEXT"
                    [e] annotationColumn-precision
                        [y] , precision = {{ functx:substring-before-if-contains(@typeParameter, ',') }}
        [g] imports
            [e] import-list
                [v] import java.util.List;
                [v] import jakarta.persistence.OneToMany;
            [e] import-map
                [v] import java.util.Map;
                [v] import java.util.HashMap;
            [e] import-fetchType
                [v] import jakarta.persistence.FetchType;
            [e] import-date
                [v] import java.time.LocalDate;
            [e] import-dateTime
            [e] import-oneToOne
                [v] import jakarta.persistence.OneToOne;
            [e] import-manyToOne
                [v] import jakarta.persistence.ManyToOne;
            [e] import-joinColumn
                [v] import jakarta.persistence.JoinColumn;
            [e] import
                [v] import {{ substring-before($class/@package,'.domain.') }}.{{ substring-after($class/@package,'.domain.') }}.entity.{{ $class/@name }}Entity;
            [e] import-cascadeType
                [v] import jakarta.persistence.CascadeType;
            [e] importClass
                [v] import {{ substring-before(@package,'.domain.') }}.{{ substring-after(@package,'.domain.') }}.domain.{{ @name }};
                [v] import {{ substring-before(@package,'.domain.') }}.{{ substring-after(@package,'.domain.') }}.builder.{{ @name }}EntityBuilder;
        [g] constructor
            [e] defaultConstructor-start
                [v] 
                [v]     public {{ ../@name }}Entity() {
            [e] defaultConstructor-close
                [v]     }
            [e] defaultConstructor-setAnyTypeCollection
                [v]         this.{{ @name }} = new ArrayList<{{ $class/@name }}>();
            [e] defaultConstructor-setAnyTypeMap
                [v]         this.{{ @name }} = new HashMap<{{ $class/@name }}Entity>();
            [e] defaultConstructor-setAnyType
                [v]         this.{{ @name }} = null;
            [e] defaultConstructor-setDate
                [v]         this.{{ @name }} = null;
            [e] defaultConstructor-setDateTime
                [v]         this.{{ @name }} = null;
            [e] defaultConstructor-setString
                [v]         this.{{ @name }} = {{ if (properties/defaultValue/value) then concat('"',properties/defaultValue/value,'"') else 'null' }};
            [e] defaultConstructor-setInteger
                [v]         this.{{ @name }} = {{ if (properties/defaultValue/value) then functx:substring-before-if-contains(properties/defaultValue/value,'.') else 0 }};
            [e] defaultConstructor-setLong
                [v]         this.{{ @name }} = {{ if (properties/defaultValue/value) then functx:substring-before-if-contains(properties/defaultValue/value,'.') else 0 }};
            [e] defaultConstructor-setDouble
                [v]         this.{{ @name }} = {{ functx:if-absent(properties/defaultValue/value, '0.0') }};
            [e] defaultConstructor-setBoolean
                [v]         this.{{ @name }} = {{ functx:if-absent(properties/defaultValue/value, false) }};
            [e] allArgsConstructor-start
                [v] 
                [v]     public {{ ../@name }}Entity(
            [e] allArgsConstructor-closeParams
                [v]     ) {
            [e] allArgsConstructor-close
                [v]     }
            [e] allArgsConstructor-paramAnyTypeCollection
                [v]         List<{{ $class/@name }}Entity> {{ @name }}{{ f#[paramSeparator] }}
            [e] allArgsConstructor-paramAnyTypeMap
                [v]         Map<String, {{ $class/@name }}> {{ @name }}{{ f#[paramSeparator] }}
            [e] allArgsConstructor-paramAnyType
                [v]         {{ $class/@name }}Entity {{ @name }}{{ f#[paramSeparator] }}
            [e] allArgsConstructor-paramComposite
                [v]         {{ $class/@name }}Entity {{ @name }}{{ f#[paramSeparator] }}
            [e] allArgsConstructor-paramDate
                [v]         LocalDate {{ @name }}{{ f#[paramSeparator] }}
            [e] allArgsConstructor-paramDateTime
                [v]         LocalDateTime {{ @name }}{{ f#[paramSeparator] }}
            [e] allArgsConstructor-paramString
                [v]         String {{ @name }}{{ f#[paramSeparator] }}
            [e] allArgsConstructor-paramBinary
                [v]         byte[] {{ @name }}{{ f#[paramSeparator] }}
            [e] allArgsConstructor-paramInteger
                [v]         Integer {{ @name }}{{ f#[paramSeparator] }}
            [e] allArgsConstructor-paramLong
                [v]         Long {{ @name }}{{ f#[paramSeparator] }}
            [e] allArgsConstructor-paramDouble
                [v]         Double {{ @name }}{{ f#[paramSeparator] }}
            [e] allArgsConstructor-paramBoolean
                [v]         Boolean {{ @name }}{{ f#[paramSeparator] }}
            [e] allArgsConstructor-bodyAnyTypeCollection
                [v]         this.{{ @name }} = {{ @name }};
            [e] allArgsConstructor-bodyAnyTypeMap
                [v]         this.{{ @name }} = {{ @name }};
            [e] allArgsConstructor-bodyAnyType
                [v]         this.{{ @name }} = {{ @name }};
            [e] allArgsConstructor-bodyDate
                [v]         this.{{ @name }} = {{ @name }};
            [e] allArgsConstructor-bodyDateTime
                [v]         this.{{ @name }} = {{ @name }};
            [e] allArgsConstructor-bodyString
                [v]         this.{{ @name }} = {{ @name }};
            [e] allArgsConstructor-bodyInteger
                [v]         this.{{ @name }} = {{ @name }};
            [e] allArgsConstructor-bodyLong
                [v]         this.{{ @name }} = {{ @name }};
            [e] allArgsConstructor-bodyDouble
                [v]         this.{{ @name }} = {{ @name }};
            [e] allArgsConstructor-bodyBoolean
                [v]         this.{{ @name }} = {{ @name }};
        [g] accessors
