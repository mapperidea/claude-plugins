        [g] builder
            [e] builderConstructor-start
                [v] 
                [v]     public {{ ../@name }}Entity({{ ../@name }}EntityBuilder builder) {
                [v]         this.version = builder.version;
            [e] builderConstructor-close
                [v]     }
            [e] builderConstructor-bodyAnyTypeCollection
                [v]         this.{{ @name }} = builder.{{ @name }};
            [e] builderConstructor-bodyAnyTypeMap
                [v]         this.{{ @name }} = builder.{{ @name }};
            [e] builderConstructor-bodyAnyType
                [v]         this.{{ @name }} = builder.{{ @name }};
            [e] builderConstructor-bodyDate
                [v]         this.{{ @name }} = builder.{{ @name }};
            [e] builderConstructor-bodyDateTime
                [v]         this.{{ @name }} = builder.{{ @name }};
