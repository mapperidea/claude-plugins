                                            [v] withExample-AnyType-close
                            [e] else
                                [e] apply-templates
                                    [e] select
                                        [v] .
                                    [e] parameters
                                        [e] nomeTODO
                                            [v] LIST_ALL_EXAMPLE_ATTRIBUTES
                                    [e] mode
                                        [v] assignTODO
                [e] template
                    [e] match
                        [v] attribute[@type = $mapNativeTypes/Date/value]
                    [e] body
                        [e] write-pattern
                            [v] predicateFromField
                [e] template
                    [e] match
                        [v] attribute[@type = $mapNativeTypes/DateTime/value]
                    [e] body
                        [e] write-pattern
                            [v] predicateFromField
                [e] template
                    [e] match
                        [v] attribute[@type = $mapNativeTypes/String/value or @type = $mapNativeTypes/BigString/value or @type = $mapNativeTypes/Binary/value]
                    [e] body
                        [e] write-pattern
                            [v] predicateFromField
                [e] template
                    [e] match
                        [v] attribute[@type = $mapNativeTypes/Integer/value]
                    [e] body
                        [e] write-pattern
                            [v] predicateFromField
                [e] template
                    [e] match
                        [v] attribute[@type = $mapNativeTypes/Long/value]
                    [e] body
                        [e] write-pattern
                            [v] predicateFromField
                [e] template
                    [e] match
                        [v] attribute[@type = $mapNativeTypes/Double/value]
                    [e] body
                        [e] write-pattern
                            [v] predicateFromField
                [e] template
                    [e] match
                        [v] attribute[@type = $mapNativeTypes/Boolean/value]
                    [e] body
                        [e] write-pattern
                            [v] predicateFromField
            [e] mode
                [v] predicateFromEntityField
                [e] template
                    [e] match
                        [v] attribute
                    [e] parameters
                        [e] attributeParent
                            [v] ND
                    [e] body
                        [e] write-pattern
                            [v] predicateFromEntityField
            [e] mode
                [v] predicate-from-entity-field
                [e] template
                    [e] match
                        [v] attribute[@type != $mapNativeTypes/*/value]
                    [e] body
                        [e] vars
                            [e] var
                                [v] pacote
                                [e] expr
                                    [v] substring-before(@type,'.')
                            [e] var
                                [v] tipo
                                [e] expr
                                    [v] mi:if-else(contains(@type,'.'), substring-after(@type,'.'), @type)
                            [e] var
                                [v] class
                                [e] expr
                                    [v] /classes/class[@name = $tipo and ends-with(@package,$pacote)]
                        [e] if
                            [v] @mode = 'oneToOne'
                            [e] then
                                [e] write-pattern
                                    [v] predicateFromEntityId
                                [e] apply-templates
                                    [e] select
                                        [v] $class/attributes/attribute[not(exists(properties/readOnly)) and not(exists(properties/storageOnly)) and @mode = 'directToField' and (@name = $class/properties/sk/value/text() or properties/searchable)]
                                    [e] parameters
                                        [e] attributeParent
                                            [e] expr
                                                [v] mi:first-lower(@name)
                                    [e] mode
                                        [v] predicateFromEntityField
        [g] directCode
            [e] mode
                [v] directLanguageCode
                [e] template
                    [e] match
                        [v] method
                    [e] body
                        [e] write-pattern
                            [v] directCode
