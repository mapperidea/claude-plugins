[b] ItemPedido
    @
        [e] title
            [e] pt
                [v] Item do Pedido
            [e] en
                [v] Order Item
        [e] description
            [e] pt
                [v] Detalhe do Pedido. Só existe dentro dele — aponta para o mestre com [m],
                  | e o mestre para cá com [o]. Referencia o Fornecedor com [r].
            [e] en
                [v] Detail of the Pedido. Only exists inside it — points to the master with [m],
                  | and the master back with [o]. References the Fornecedor with [r].
    [g] identificacao
        [d] id: Texto(36)
            @
                [e] cn
                    [v] id
                [e] title
                    [e] pt
                        [v] Identificador
                    [e] en
                        [v] Identifier
                [e] required
                    [v] true
        [d] descricao: Texto(255)
            @
                [e] cn
                    [v] descricao
                [e] title
                    [e] pt
                        [v] Descrição
                    [e] en
                        [v] Description
                [e] required
                    [v] true
    [g] valores
        [d] quantidade: Inteiro(5)
            @
                [e] cn
                    [v] quantidade
                [e] title
                    [e] pt
                        [v] Quantidade
                    [e] en
                        [v] Quantity
                [e] required
                    [v] true
                [e] defaultValue
                    [v] 1
        [d] precoUnitario: ValorMonetario()
            @
                [e] cn
                    [v] preco_unitario
                [e] title
                    [e] pt
                        [v] Preço unitário
                    [e] en
                        [v] Unit price
                [e] required
                    [v] true
    [g] relacionamentos
        [m] pedido: Pedido()
            @
                [e] cn
                    [v] pedido_id
                [e] title
                    [e] pt
                        [v] Pedido
                    [e] en
                        [v] Order
                [e] required
                    [v] true
        [r] fornecedor: Fornecedor()
            @
                [e] cn
                    [v] fornecedor_id
                [e] title
                    [e] pt
                        [v] Fornecedor
                    [e] en
                        [v] Supplier
