[e] builder
    [e] parameters
        [e] modelName
            [v] NOT_DEFINED
        [e] package
            [v] NOT_DEFINED
    [e] vars
        [e] mapNativeTypes
            [e] select
                [v] //maps/mapNativeTypes
        [e] classes
            [e] select
                [v] /classes
    [e] fragments
        [e] tabulaDescription
            [v] for $linha in functx:lines(string-join(properties/description/pt/value,codepoints-to-string(10))) return mi:tabulate-text(concat(normalize-space($linha),codepoints-to-string(10)),'* ',80)
        [e] paramSeparator
            [v] mi:if-else(position() = last(), '', ',')
        [e] attributeLast
            [v] mi:if-else(position() = last(), ';', '')
    [e] patterns
        [e] package
            [v] package {{ substring-before(@package,'.domain.') }}.{{ substring-after(@package,'.domain.') }}.builder;
            [v] 
            [v] import java.time.LocalDateTime;
        [e] importClass
            [v] import {{ substring-before(@package,'.domain.') }}.{{ substring-after(@package,'.domain.') }}.domain.{{ @name }};
            [v] import {{ substring-before(@package,'.domain.') }}.{{ substring-after(@package,'.domain.') }}.entity.{{ @name }}Entity;
        [e] class-start
            [v] 
            [v] /*
            [v]  * {{ @name }} entity builder
            [v] */
            [v] public class {{ @name }}EntityBuilder {
        [e] class-close
            [v] 
            [v] }
        [g] imports
            [e] import-list
                [v] import java.util.List;
                [v] import java.util.ArrayList;
            [e] import-map
                [v] import java.util.Map;
                [v] import java.util.HashMap;
            [e] import-date
                [v] import java.time.LocalDate;
            [e] import-dateTime
            [e] import
                [v] import {{ substring-before($package,'.domain.') }}.{{ $packageAttribute }}entity.{{ $nameAttribute }}Entity;
        [g] builder
            [e] builderSystemFields
                [v]
                [v]     public LocalDateTime version;
            [g] attributes
                [e] builderClass-attributeAnyType
                    [v]     public {{ $class/@name }}Entity {{ @name }};
                [e] builderClass-attributeDate
                    [v]     public LocalDate {{ @name }};
                [e] builderClass-attributeDateTime
                    [v]     public LocalDateTime {{ @name }};
                [e] builderClass-attributeAnyTypeCollection
                    [v]     public List<{{ $class/@name }}Entity> {{ @name }};
                [e] builderClass-attributeAnyTypeMap
                    [v]     public Map<{{ $class/@name }}Entity> {{ @name }};
                [e] builderClass-attributeString
                    [v]     public String {{ @name }};
                [e] builderClass-attributeBigString
                    [v]     public String {{ @name }};
                [e] builderClass-attributeBinary
                    [v]     public byte[] {{ @name }};
                [e] builderClass-attributeInteger
                    [v]     public Integer {{ @name }};
                [e] builderClass-attributeLong
                    [v]     public Long {{ @name }};
                [e] builderClass-attributeDouble
                    [v]     public Double {{ @name }};
                [e] builderClass-attributeBoolean
                    [v]     public Boolean {{ @name }};
            [e] builderClassConstructorNoArgs
                [v] 
                [v]     public {{ ../@name }}EntityBuilder() {
                [v]     }
            [e] builderClass-withSystemFields
                [v]
                [v]     public {{ ../@name }}EntityBuilder withVersion(LocalDateTime version) {
                [v]         this.version = version;
                [v]         return this;
                [v]     }
            [g] withAttributes
                [e] builderClass-withAttributeAnyType
                    [v] 
                    [v]     public {{ ../../@name }}EntityBuilder with{{ mi:first-upper(@name) }}({{ $class/@name }}Entity {{ @name }}) {
                    [v]         this.{{ @name }} = {{ @name }};
                    [v]         return this;
                    [v]     }
                [e] builderClass-withAttributeDate
                    [v] 
                    [v]     public {{ ../../@name }}EntityBuilder with{{ mi:first-upper(@name) }}(LocalDate {{ @name }}) {
                    [v]         this.{{ @name }} = {{ @name }};
                    [v]         return this;
                    [v]     }
                [e] builderClass-withAttributeDateTime
                    [v] 
                    [v]     public {{ ../../@name }}EntityBuilder with{{ mi:first-upper(@name) }}(LocalDateTime {{ @name }}) {
                    [v]         this.{{ @name }} = {{ @name }};
                    [v]         return this;
                    [v]     }
                [e] builderClass-withAttributeAnyTypeCollection
                    [v] 
                    [v]     public {{ ../../@name }}EntityBuilder with{{ mi:first-upper(@name) }}(List<{{ $class/@name }}Entity> {{ @name }}) {
                    [v]         this.{{ @name }} = {{ @name }};
                    [v]         return this;
                    [v]     }
                [e] builderClass-withAttributeAnyTypeMap
                    [v] 
                    [v]     public {{ ../../@name }}EntityBuilder with{{ mi:first-upper(@name) }}(Map<{{ $class/@name }}Entity> {{ @name }}) {
                    [v]         this.{{ @name }} = {{ @name }};
                    [v]         return this;
                    [v]     }
                [e] builderClass-withAttributeString
                    [v] 
                    [v]     public {{ ../../@name }}EntityBuilder with{{ mi:first-upper(@name) }}(String {{ @name }}) {
                    [v]         this.{{ @name }} = {{ @name }};
                    [v]         return this;
                    [v]     }
                [e] builderClass-withAttributeBinary
                    [v] 
                    [v]     public {{ ../../@name }}EntityBuilder with{{ mi:first-upper(@name) }}(byte[] {{ @name }}) {
                    [v]         this.{{ @name }} = {{ @name }};
                    [v]         return this;
                    [v]     }
                [e] builderClass-withAttributeInteger
                    [v] 
                    [v]     public {{ ../../@name }}EntityBuilder with{{ mi:first-upper(@name) }}(Integer {{ @name }}) {
                    [v]         this.{{ @name }} = {{ @name }};
                    [v]         return this;
                    [v]     }
                [e] builderClass-withAttributeLong
                    [v] 
                    [v]     public {{ ../../@name }}EntityBuilder with{{ mi:first-upper(@name) }}(Long {{ @name }}) {
                    [v]         this.{{ @name }} = {{ @name }};
                    [v]         return this;
                    [v]     }
                [e] builderClass-withAttributeDouble
                    [v] 
                    [v]     public {{ ../../@name }}EntityBuilder with{{ mi:first-upper(@name) }}(Double {{ @name }}) {
                    [v]         this.{{ @name }} = {{ @name }};
                    [v]         return this;
                    [v]     }
                [e] builderClass-withAttributeBoolean
                    [v] 
                    [v]     public {{ ../../@name }}EntityBuilder with{{ mi:first-upper(@name) }}(Boolean {{ @name }}) {
                    [v]         this.{{ @name }} = {{ @name }};
                    [v]         return this;
                    [v]     }
            [e] builderClass-build
                [v] 
                [v]     public {{ ../@name }}Entity build() {
                [v]         return new {{ ../@name }}Entity(this);
                [v]     }
            [g] withModel
                [e] withModel-start
                    [v] 
                    [v]     public {{ @name }}EntityBuilder withModel({{ @name }} {{ mi:first-lower(@name) }}) {
                    [v]         return this.withVersion({{ mi:first-lower(@name) }}.getVersion())
                [e] withModel-end
                    [v]     }
                [g] attributes
                    [e] withModel-directToField
                        [v]                 .with{{ mi:first-upper(@name) }}({{ $className }}.get{{ mi:first-upper(@name) }}()){{ f#[attributeLast] }}
                    [e] withModel-oneToOne
                        [v]                 .with{{ mi:first-upper(@name) }}({{ mi:first-upper($typeName) }}Entity.builderOf().withModel({{ $className }}.get{{ mi:first-upper(@name) }}()).build()){{ f#[attributeLast] }}
                    [e] withModel-composite
                        [v]                 .with{{ mi:first-upper(@name) }}({{ mi:first-upper($typeName) }}Entity.builderOf().withModel({{ $className }}.get{{ mi:first-upper(@name) }}()).build()){{ f#[attributeLast] }}
                    [e] withModel-oneToMany
                        [y]                 .with{{ mi:first-upper(@name) }}(
                        [y] {{ mi:first-upper($typeName) }}Entity.builderOf().withModelList({{ $className }}.get{{ mi:first-upper(@name) }}())
                        [v] ){{ f#[attributeLast] }}
                    [e] withModel-manyToOne
                        [v]                 .with{{ mi:first-upper(@name) }}({{ mi:first-upper($typeName) }}Entity.builderOf().withModel({{ $className }}.get{{ mi:first-upper(@name) }}()).build()){{ f#[attributeLast] }}
                [g] withModelList
                    [e] withModelList
                        [v] 
                        [v]     public List<{{ @name }}Entity> withModelList(List<{{ @name }}> {{ mi:first-lower(@name) }}List) {
                        [v]         if ({{ mi:first-lower(@name) }}List == null) {
                        [v]             return null;
                        [v]         }
                        [v] 
                        [v]         List<{{ @name }}Entity> list = new ArrayList<{{ @name }}Entity>({{ mi:first-lower(@name) }}List.size());
                        [v]         for ({{ @name }} {{ mi:first-lower(@name) }}: {{ mi:first-lower(@name) }}List) {
                        [v]            list.add(withModel({{ mi:first-lower(@name) }}).build());
                        [v]         }
                        [v]         return list;
                        [v]     }
        [g] @TODO
            [e] declaraTODO
                [v] //@TODO _ tem que implementar: {{ $nomeTODO }}
                [v] //Caminho xpath: {{ functx:path-to-node-with-pos(current()) }}
            [e] declara-labelEstruturaXpath
            [e] start-labelEstruturaXpath
                [y] //Estrutura xpath: .[
            [e] end-labelEstruturaXpath
                [v] ]
            [e] declara-nomeDoElemento
                [y] name()='{{ name() }}'
            [g] Estrutura xpath
                [e] declara-barra
                    [y] /
                [e] declara-contadorElementosFilhos
                    [y] count(*)={{ count(child::*) }}
                [e] declara-andEspacoEmBranco
                    [y]  and 
                [e] declara-clausulaPositionName
                    [y] child::*[position()={{ position() }} and name()='{{ name() }}']
                [e] start-clausulaContZeroText
                    [y] /.[count(*)=0 and 
                [e] end-clausulaContZeroText
                    [y] ]
                [e] declara-clausulaText
                    [y] text()='{{ text() }}'
                [e] declara-clausulaTextName
                    [y] text()
                [e] declara-prefixoName
                    [y] {{ $prefixoNome }}
                [e] declara-clausulaNotTextName
                    [y] not(text())
    [e] start
        [e] match
            [v] /classes/class[@name = $modelName and @package = $package]
        [e] body
            [e] write-pattern
                [v] package
            [g] import
                [e] write-pattern
                    [v] importClass
                [e] write-pattern
                    [v] import-list
                [e] if
                    [v] attributes/attribute[@mode = 'directMap']
                    [e] then
                        [e] write-pattern
                            [v] import-map
                [e] if
                    [v] attributes/attribute[@type = $mapNativeTypes/Date/value]
                    [e] then
                        [e] write-pattern
                            [v] import-date
                [e] if
                    [v] attributes/attribute[@type = $mapNativeTypes/DateTime/value]
                    [e] then
                        [e] write-pattern
                            [v] import-dateTime
            [e] apply-templates
                [e] select
                    [v] distinct-values(attributes/attribute[@mode != 'directToField']/@type)
                [e] mode
                    [v] imports
            [e] write-pattern
                [v] class-start
            [e] apply-templates
                [e] select
                    [v] attributes
                [e] mode
                    [v] builder
            [e] apply-templates
                [e] select
                    [v] .
                [e] mode
                    [v] withModel
            [e] write-pattern
                [v] class-close
    [e] templates
        [e] mode
            [v] imports
            [e] template
                [e] match
                    [v] .
                [e] body
                    [e] vars
                        [e] var
                            [v] valorAtual
                            [e] expr
                                [v] .
                        [e] var
                            [v] nameAttribute
                            [e] expr
                                [v] functx:substring-after-last($valorAtual, '.')
                        [e] var
                            [v] packageAttribute
                            [e] expr
                                [v] mi:if-else(contains($valorAtual, '.'), substring-before($valorAtual, $nameAttribute), concat(substring-after($classes/class[@name = $nameAttribute][1]/@package, '.domain.'), '.'))
                    [e] write-pattern
                        [v] import
        [e] mode
            [v] constructors
            [e] template
                [e] match
                    [v] attributes
                [e] body
                    [e] write-pattern
                        [v] defaultConstructor-start
                    [e] write-pattern
                        [v] defaultConstructor-close
                    [e] write-pattern
                        [v] allArgsConstructor-start
                    [e] apply-templates
                        [e] select
                            [v] attribute
                        [e] mode
                            [v] allArgsConstructor-params
                    [e] write-pattern
                        [v] allArgsConstructor-closeParams
                    [e] apply-templates
                        [e] select
                            [v] attribute
                        [e] mode
                            [v] allArgsConstructor-body
                    [e] write-pattern
                        [v] allArgsConstructor-close
        [e] mode
            [v] builder
            [e] template
                [e] match
                    [v] attributes
                [e] body
                    [e] write-pattern
                        [v] builderSystemFields
                    [e] apply-templates
                        [e] select
                            [v] attribute
                        [e] mode
                            [v] builderClass-attributes
                    [e] write-pattern
                        [v] builderClassConstructorNoArgs
                    [e] write-pattern
                        [v] builderClass-withSystemFields
                    [e] apply-templates
                        [e] select
                            [v] attribute
                        [e] mode
                            [v] builderClass-withAttributes
                    [e] write-pattern
                        [v] builderClass-build
        [e] mode
            [v] builderClass-attributes
            [e] template
                [e] match
                    [v] attribute[@type != $mapNativeTypes/*/value]
                [e] body
                    [e] vars
                        [e] var
                            [v] pacote
                            [e] expr
                                [v] substring-before(@type,'.')
                        [e] var
                            [v] tipo
                            [e] expr
                                [v] mi:if-else(contains(@type,'.'), substring-after(@type,'.'), @type)
                        [e] var
                            [v] class
                            [e] expr
                                [v] /classes/class[@name = $tipo and ends-with(@package,$pacote)]
                    [e] if
                        [v] contains(@mode,'oneToMany')
                        [e] then
                            [e] write-pattern
                                [v] builderClass-attributeAnyTypeCollection
                        [e] else-if
                            [v] @mode = 'directMap'
                            [e] then
                                [e] write-pattern
                                    [v] builderClass-attributeAnyTypeMap
                        [e] else-if
                            [v] @mode = 'oneToOne'
                            [e] then
                                [e] write-pattern
                                    [v] builderClass-attributeAnyType
                        [e] else-if
                            [v] @mode = 'composite'
                            [e] then
                                [e] write-pattern
                                    [v] builderClass-attributeAnyType
                        [e] else-if
                            [v] @mode = 'manyToOne'
                            [e] then
                                [e] write-pattern
                                    [v] builderClass-attributeAnyType
                        [e] else
                            [e] apply-templates
                                [e] select
                                    [v] .
                                [e] parameters
                                    [e] nomeTODO
                                        [v] BUILDER_CLASS_ATTRIBUTES
                                [e] mode
                                    [v] assignTODO
            [e] template
                [e] match
                    [v] attribute[@type = $mapNativeTypes/Date/value]
                [e] body
                    [e] write-pattern
                        [v] builderClass-attributeDate
            [e] template
                [e] match
                    [v] attribute[@type = $mapNativeTypes/DateTime/value]
                [e] body
                    [e] write-pattern
                        [v] builderClass-attributeDateTime
            [e] template
                [e] match
                    [v] attribute[@type = $mapNativeTypes/String/value]
                [e] body
                    [e] write-pattern
                        [v] builderClass-attributeString
            [e] template
                [e] match
                    [v] attribute[@type = $mapNativeTypes/BigString/value]
                [e] body
                    [e] write-pattern
                        [v] builderClass-attributeBigString
            [e] template
                [e] match
                    [v] attribute[@type = $mapNativeTypes/Binary/value]
                [e] body
                    [e] write-pattern
                        [v] builderClass-attributeBinary
            [e] template
                [e] match
                    [v] attribute[@type = $mapNativeTypes/Integer/value]
                [e] body
                    [e] write-pattern
                        [v] builderClass-attributeInteger
            [e] template
                [e] match
                    [v] attribute[@type = $mapNativeTypes/Long/value]
                [e] body
                    [e] write-pattern
                        [v] builderClass-attributeLong
            [e] template
                [e] match
                    [v] attribute[@type = $mapNativeTypes/Double/value]
                [e] body
                    [e] write-pattern
                        [v] builderClass-attributeDouble
            [e] template
                [e] match
                    [v] attribute[@type = $mapNativeTypes/Boolean/value]
                [e] body
                    [e] write-pattern
                        [v] builderClass-attributeBoolean
        [e] mode
            [v] builderClass-withAttributes
            [e] template
                [e] match
                    [v] attribute[@type != $mapNativeTypes/*/value]
                [e] body
                    [e] vars
                        [e] var
                            [v] pacote
                            [e] expr
                                [v] substring-before(@type,'.')
                        [e] var
                            [v] tipo
                            [e] expr
                                [v] mi:if-else(contains(@type,'.'), substring-after(@type,'.'), @type)
                        [e] var
                            [v] class
                            [e] expr
                                [v] /classes/class[@name = $tipo and ends-with(@package,$pacote)]
                    [e] if
                        [v] contains(@mode,'oneToMany')
                        [e] then
                            [e] write-pattern
                                [v] builderClass-withAttributeAnyTypeCollection
                        [e] else-if
                            [v] @mode = 'directMap'
                            [e] then
                                [e] write-pattern
                                    [v] builderClass-withAttributeAnyTypeMap
                        [e] else
                            [e] write-pattern
                                [v] builderClass-withAttributeAnyType
            [e] template
                [e] match
                    [v] attribute[@type = $mapNativeTypes/Date/value]
                [e] body
                    [e] write-pattern
                        [v] builderClass-withAttributeDate
            [e] template
                [e] match
                    [v] attribute[@type = $mapNativeTypes/DateTime/value]
                [e] body
                    [e] write-pattern
                        [v] builderClass-withAttributeDateTime
            [e] template
                [e] match
                    [v] attribute[@type = $mapNativeTypes/String/value]
                [e] body
                    [e] write-pattern
                        [v] builderClass-withAttributeString
            [e] template
                [e] match
                    [v] attribute[@type = $mapNativeTypes/BigString/value]
                [e] body
                    [e] write-pattern
                        [v] builderClass-withAttributeString
            [e] template
                [e] match
                    [v] attribute[@type = $mapNativeTypes/Binary/value]
                [e] body
                    [e] write-pattern
                        [v] builderClass-withAttributeBinary
            [e] template
                [e] match
                    [v] attribute[@type = $mapNativeTypes/Integer/value]
                [e] body
                    [e] write-pattern
                        [v] builderClass-withAttributeInteger
            [e] template
                [e] match
                    [v] attribute[@type = $mapNativeTypes/Long/value]
                [e] body
                    [e] write-pattern
                        [v] builderClass-withAttributeLong
            [e] template
                [e] match
                    [v] attribute[@type = $mapNativeTypes/Double/value]
                [e] body
                    [e] write-pattern
                        [v] builderClass-withAttributeDouble
            [e] template
                [e] match
                    [v] attribute[@type = $mapNativeTypes/Boolean/value]
                [e] body
                    [e] write-pattern
                        [v] builderClass-withAttributeBoolean
        [e] mode
            [v] withModel
            [e] template
                [e] match
                    [v] class
                [e] body
                    [g] withModel
                        [e] write-pattern
                            [v] withModel-start
                        [e] apply-templates
                            [e] select
                                [v] attributes/attribute[not(exists(properties/storageOnly)) and (not(contains(@mode,'oneToMany')) or properties/apiRelation/value = 'EMBEDDED')]
                            [e] parameters
                                [e] className
                                    [e] expr
                                        [v] mi:first-lower(@name)
                        [e] write-pattern
                            [v] withModel-end
                    [g] withModelList
                        [e] write-pattern
                            [v] withModelList
            [e] template
                [e] match
                    [v] attribute
                [e] parameters
                    [e] className
                        [v] NOT_DEFINED
                [e] body
                    [e] vars
                        [e] var
                            [v] typeName
                            [e] expr
                                [v] functx:substring-after-last(@type, '.')
                    [e] if
                        [v] @mode="directToField"
                        [e] then
                            [e] write-pattern
                                [v] withModel-directToField
                        [e] else-if
                            [v] @mode="oneToOne"
                            [e] then
                                [e] write-pattern
                                    [v] withModel-oneToOne
                        [e] else-if
                            [v] @mode="composite"
                            [e] then
                                [e] write-pattern
                                    [v] withModel-composite
                        [e] else-if
                            [v] @mode="oneToMany"
                            [e] then
                                [e] write-pattern
                                    [v] withModel-oneToMany
                        [e] else-if
                            [v] @mode="manyToOne"
                            [e] then
                                [e] write-pattern
                                    [v] withModel-manyToOne
                        [e] else
                            [e] apply-templates
                                [e] select
                                    [v] .
                                [e] parameters
                                    [e] nomeTODO
                                        [v] WITH-MODEL-ATTRIBUTE
                                [e] mode
                                    [v] assignTODO
        [g] @TODO
            [e] mode
                [v] assignTODO
                [e] template
                    [e] match
                        [v] *
                    [e] parameters
                        [e] nomeTODO
                            [v] NOT_DEFINED
                    [e] body
                        [e] write-pattern
                            [v] declaraTODO
                        [e] write-pattern
                            [v] start-labelEstruturaXpath
                        [e] write-pattern
                            [v] declara-contadorElementosFilhos
                        [e] write-pattern
                            [v] declara-andEspacoEmBranco
                        [e] write-pattern
                            [v] declara-nomeDoElemento
                        [e] if
                            [v] count(./*)>0
                            [e] then
                                [e] write-pattern
                                    [v] declara-andEspacoEmBranco
                                [e] apply-templates
                                    [e] select
                                        [v] ./*
                                    [e] parameters
                                        [e] prefixoNome
                                            [e] expr
                                                [v] ''
                                    [e] mode
                                        [v] estruturaXpath
                        [e] write-pattern
                            [v] end-labelEstruturaXpath
                        [e] write-pattern
                            [v] quebraLinha
            [e] mode
                [v] estruturaXpath
                [e] template
                    [e] match
                        [v] *
                    [e] parameters
                        [e] prefixoNome
                            [v] NOT_DEFINED
                    [e] body
                        [e] if
                            [v] $prefixoNome != ''
                            [e] then
                                [e] write-pattern
                                    [v] declara-prefixoName
                        [e] write-pattern
                            [v] declara-clausulaPositionName
                        [e] if
                            [v] .[count(*)=0 and text()]
                            [e] then
                                [e] write-pattern
                                    [v] start-clausulaContZeroText
                                [e] write-pattern
                                    [v] declara-clausulaText
                                [e] write-pattern
                                    [v] end-clausulaContZeroText
                            [e] else-if
                                [v] .[count(*)=0 and not(text())]
                                [e] then
                                    [e] write-pattern
                                        [v] start-clausulaContZeroText
                                    [e] write-pattern
                                        [v] declara-clausulaNotTextName
                                    [e] write-pattern
                                        [v] end-clausulaContZeroText
                            [e] else
                                [e] vars
                                    [e] var
                                        [v] valueNameTratar
                                        [e] expr
                                            [v] name()
                                    [e] var
                                        [v] valueName
                                        [e] expr
                                            [v] concat(concat($prefixoNome, $valueNameTratar), '/')
                                [e] write-pattern
                                    [v] declara-barra
                                [e] write-pattern
                                    [v] declara-contadorElementosFilhos
                                [e] write-pattern
                                    [v] declara-andEspacoEmBranco
                                [e] apply-templates
                                    [e] select
                                        [v] ./*
                                    [e] parameters
                                        [e] prefixoNome
                                            [e] expr
                                                [v] $valueName
                                    [e] mode
                                        [v] estruturaXpath
                        [e] if
                            [v] position() != last()
                            [e] then
                                [e] write-pattern
                                    [v] declara-andEspacoEmBranco
