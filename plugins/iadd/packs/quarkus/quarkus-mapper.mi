            [e] select
                [v] //maps/mapNativeTypes
        [e] classes
            [e] select
                [v] /classes
        [e] inicioPacote
            [e] expr
                [v] concat(substring-before($package, '.domain.'), '.domain.')
        [e] transactionManager
            [e] expr
                [v] /classes/package[@name = $package]/properties/transaction/value
        [e] classSchema
            [e] select
                [v] /classes/class[@name = 'CurrentSchema']
        [e] map
            [e] select
                [v] $classSchema/properties/projectNames/map/value
    [e] fragments
        [e] tabulaDescription
            [v] for $linha in functx:lines(string-join(properties/description/pt/value,codepoints-to-string(10))) return mi:tabulate-text(concat(normalize-space($linha),codepoints-to-string(10)),'* ',80)
        [e] paramSeparator
            [v] mi:if-else(position() = last(), '', ',')
